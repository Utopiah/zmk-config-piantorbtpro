#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        QWERTY {
            bindings = <
  &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P      &mt LCTRL A  &mt LSHFT S  &mt LALT D  &mt LGUI F  &lt 1 G  &lt 2 H  &mt RGUI J  &mt RALT K  &mt RSHFT L  &mt RCTRL SEMI      &kp Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH    &mo 3  &mo 1  &kp SPACE  &kp RET  &mo 2  &mo 4
            >;
        };
    };
};
